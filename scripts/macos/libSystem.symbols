# libSystem's functions TurboMojo may use on macOS, one per line (Mach-O names: a C
# function f is _f). scripts/macos-link.sh links against exactly these, so a call of a
# Linux-only function (close_range, eventfd, inotify_*, memfd_create, statx...) fails the
# link here instead of the program's start on a Mac. Add a name only after checking that
# macOS has it (man page or the SDK's headers); the list was written from the macOS
# documentation, not read from a Mac.
___error
___ulock_wait
___ulock_wake
__availability_version_check
__exit
_access
_arc4random_buf
_bzero
_calloc
_chdir
_clock_gettime_nsec_np
_close
_close$NOCANCEL
_closedir
_dup
_dup2
_execvp
_exit
_exp
_expf
_fclose
_fcntl
_fdopen
_fflush
_fileno
_fopen
_fork
_fread
_free
_fseek
_fstat
_fstatat
_ftell
_fwrite
_getcwd
_getdtablesize
_getenv
_gethostname
_getpid
_grantpt
_ioctl
_isatty
_kevent
_kill
_kqueue
_localtime_r
_log
_logf
