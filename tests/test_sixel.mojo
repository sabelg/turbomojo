"""Tests for images in the docs pane, third part (P10-22c): sixel. The decoder (zlib
inflate: stored, fixed and dynamic blocks; PNG: every colour type, filters 0-4,
palettes with transparency, 1 to 16 bits) gives the same pixels as the encoder that
made the fixtures (Python's zlib, by the test author) and refuses what it cannot read;
the sixel encoder's output is what the format says; the reader draws a sixel picture
over blank cells when it is wholly on the page, wipes it when it moves away, and does
not draw it again while nothing changed."""
from std.testing import assert_equal, assert_true, assert_false, TestSuite
from std.collections import List
from inflate import zlib_inflate
from png import png_decode, Picture
from sixel import sixel_encode, scale_to, fit_pixels, cube_index
from caps import caps_query, CELL_SIZE_QUERY
from term import Terminal, key_event, fkey, MOD_SHIFT
from app import *
from appstate import App
from signals import own_pid
from util import env_or, run_system, shell_quote, write_file, str_bytes, bytes_to_str

# (made with Python's zlib by the test author; see the docstring)
comptime PNG_RGB8 = ""
comptime RGBA_RGB8 = ""
comptime PNG_RGBA8 = ""
comptime RGBA_RGBA8 = ""
comptime PNG_PAL4 = ""
comptime RGBA_PAL4 = ""
comptime PNG_GA16 = "89504e470d0a1a0a0000000d4948445200000009000000071004000000200273a80000002749444154789c636060e5e217919453d6d03532b77174f30e088d8a4fc9cc2baea86d6aef99386df682a5ab7c2b40530000002749444154d63332b2710b8810004c8c4400662656762e6e02808518938871f71690bb4509391c00f7e320748b0b094a0000000049454e44ae426082"
comptime RGBA_GA16 = ""
comptime PNG_GREY1 = "89504e470d0a1a0a0000000d4948445200000009000000070100000000f2e05acd0000000e49444154789c630865606460600a6560bec6875658540000000f49444154c012ba9a818181317435001db6038c4118be4d0000000049454e44ae426082"
comptime RGBA_GREY1 = ""
comptime PNG_INTERLACED = "89504e470d0a1a0a0000000d494844520000000900000007080200000122fec0a10000000e49444154789c6360c00d18f1c831e19163c6fc49e8d50000000e4944415423c782470e1fc0e716000540000c675aa3d70000000049454e44ae426082"
comptime PNG_STRIPES = ""
comptime Z_TEXT = "616272616361646162726120616272616361646162726120616272616361646162726120"
comptime Z_STORED = "7801012400dbff616272616361646162726120616272616361646162726120616272616361646162726120fb850d5d"
comptime Z_FIXED = "78014b4c2a4a4c4e4c4904520a8938d800fb850d5d"
comptime Z_BIG = ""
comptime Z_DYNAMIC = ""


def unhex(s: String) -> List[UInt8]:
    var out = List[UInt8]()
    var b = s.as_bytes()
    for k in range(0, len(b) - 1, 2):
        var hi = Int(b[k]) - 48 if Int(b[k]) < 58 else Int(b[k]) - 87
        var lo = Int(b[k + 1]) - 48 if Int(b[k + 1]) < 58 else Int(b[k + 1]) - 87
        out.append(UInt8(hi * 16 + lo))
    return out^


def same(a: List[UInt8], b: List[UInt8]) -> Bool:
    if len(a) != len(b):
        return False
    for k in range(len(a)):
        if a[k] != b[k]:
            return False
    return True


def test_inflate() raises:
    for z in [Z_STORED, Z_FIXED]:
        var r = zlib_inflate(unhex(String(z)), 100000)
        assert_true(r[0])
        assert_true(same(r[1], unhex(Z_TEXT)))
    var d = zlib_inflate(unhex(Z_DYNAMIC), 100000)
    assert_true(d[0])
    assert_true(same(d[1], unhex(Z_BIG)))
    # more than allowed: refused (a small file that would grow without end)
    assert_false(zlib_inflate(unhex(Z_DYNAMIC), 1000)[0])
    # damaged: refused, never a crash
    var bad = unhex(Z_DYNAMIC)
    for k in range(10, 40):
        bad[k] = UInt8(255 - Int(bad[k]))
    _ = zlib_inflate(bad, 100000)
    var cut = unhex(Z_DYNAMIC)
    cut.resize(len(cut) // 2, 0)
    assert_false(zlib_inflate(cut, 100000)[0])
    assert_false(zlib_inflate(unhex("7801"), 100000)[0])


def test_png_pictures() raises:
    var pngs: List[String] = [PNG_RGB8, PNG_RGBA8, PNG_PAL4, PNG_GA16, PNG_GREY1]
    var want: List[String] = [RGBA_RGB8, RGBA_RGBA8, RGBA_PAL4, RGBA_GA16, RGBA_GREY1]
    for k in range(len(pngs)):
        var pic = png_decode(unhex(pngs[k]))
        assert_true(pic.ok, String(k))
        assert_equal(pic.w, 9)
        assert_equal(pic.h, 7)
        assert_true(same(pic.rgba, unhex(want[k])), String(k))
    assert_false(png_decode(unhex(PNG_INTERLACED)).ok)       # Adam7: not read
    var short = unhex(PNG_RGB8)
    short.resize(60, 0)
    assert_false(png_decode(short).ok)
    assert_false(png_decode(str_bytes("not a picture at all, not even close")).ok)


def test_damaged_pictures_never_crash() raises:
    # (a file of the download could be anything: bytes changed at random, the same
    # each run; every one must be read or refused, never crash)
    var seed = 12345
    var pngs: List[String] = [PNG_RGB8, PNG_PAL4, PNG_GA16, PNG_STRIPES]
    var refused = 0
    for round in range(400):
        var d = unhex(pngs[round % len(pngs)])
        for _ in range(1 + round % 6):
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
            var at = 8 + seed % (len(d) - 8)
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
            d[at] = UInt8(seed & 255)
        if round % 7 == 0:
            d.resize(len(d) * 2 // 3, 0)
        var pic = png_decode(d)
        if not pic.ok:
            refused += 1
        else:
            assert_equal(len(pic.rgba), pic.w * pic.h * 4)
    assert_true(refused > 100)


def solid(w: Int, h: Int, rgba: List[Int]) -> Picture:
    var p = Picture()
    p.w = w
    p.h = h
    for _ in range(w * h):
        for c in rgba:
            p.rgba.append(UInt8(c))
    p.ok = True
    return p^


def test_sixel_output() raises:
    # 2 x 7: six red rows, then a blue one
    var px = List[UInt8]()
    for y in range(7):
        for _ in range(2):
            if y < 6:
                px.append(255); px.append(0); px.append(0); px.append(255)
            else:
                px.append(0); px.append(0); px.append(255); px.append(255)
    assert_equal(cube_index(255, 0, 0), 180)
    assert_equal(sixel_encode(px, 2, 7, 0), "\x1bP0;1;0q\"1;1;2;7#5;2;0;0;100#180;2;100;0;0#180~~-#5@@-\x1b\\")
    # runs: ten the same as one count; a transparent pixel left out; half alpha mixed
    var wide = scale_to(solid(1, 1, [0, 255, 0, 255]), 10, 1)
    assert_equal(len(wide), 40)
    assert_true(sixel_encode(wide, 10, 1, 0).find("#30!10@-") >= 0, sixel_encode(wide, 10, 1, 0))
    var holes = List[UInt8]()
    for c in [255, 255, 255, 255, 0, 0, 0, 0, 255, 255, 255, 128]:
        holes.append(UInt8(c))
    var s = sixel_encode(holes, 3, 1, 0)
    assert_true(s.find("#215@?") >= 0 or s.find("#215@") >= 0, s)       # white, a gap
    assert_true(s.find("#129") >= 0, s)                     # 50 % white on black: grey (3,3,3)
    var f = fit_pixels(200, 100, 100, 100)
    assert_equal(f[0], 100)
    assert_equal(f[1], 50)
    var g = fit_pixels(100, 400, 100, 100)
    assert_equal(g[0], 25)
    assert_equal(g[1], 100)


def test_the_cell_size() raises:
    var t = Terminal()
    assert_equal(len(t.feed(str_bytes("\x1b[6;18;9t"), False)), 0)
    assert_equal(t.caps.cell_h, 18)
    assert_equal(t.caps.cell_w, 9)
    _ = t.feed(str_bytes("\x1b[6;0;0t"), False)                     # nonsense: kept
    assert_equal(t.caps.cell_w, 9)
    var q = caps_query(False)
    assert_true(q.find(CELL_SIZE_QUERY) >= 0 and q.find(CELL_SIZE_QUERY) < q.find("\x1b[c"))


def test_which_kind() raises:
    var a = App()
    a.gfx_decide(False, "", "", "", True)
    assert_true(a.gfx_on and a.gfx_sixel)                   # auto: DA1 said sixel
    a.gfx_decide(True, "", "", "", True)
    assert_true(a.gfx_on and not a.gfx_sixel)               # kitty graphics first
    a.images_mode = "sixel"
    a.gfx_decide(False, "", "", "", False)
    assert_true(a.gfx_on and a.gfx_sixel)
    a.images_mode = "off"
    a.gfx_decide(False, "", "", "", True)
    assert_false(a.gfx_on)


def cells_dirty(app: App, x: Int, y: Int, w: Int, h: Int) -> Bool:
    for yy in range(y, y + h):
        for xx in range(x, x + w):
            if app.scr.pch[yy * app.scr.w + xx] != -2:
                return False
    return True


def test_a_sixel_picture_in_the_reader() raises:
    var d = env_or("TMPDIR", "/tmp") + "/turbomojo-sixel-" + String(own_pid())
    var site = d + "/modular/Mojo/docs/site/manual"
    _ = run_system("rm -rf " + shell_quote(d) + " && mkdir -p " + shell_quote(site + "/images"))
    _ = write_file(site + "/images/stripes.png", unhex(PNG_STRIPES))
    _ = write_file(site + "/images/inter.png", unhex(PNG_INTERLACED))
    _ = write_file(site + "/pics.mdx", str_bytes("---\ntitle: Pictures\n---\n\n" + "Above.\n\n" * 30 + "![Stripes](./images/stripes.png)\n\n![Interlaced](./images/inter.png)\n\n" + "More text.\n\n" * 40))
    var app = App()
    app.scr.resize(120, 34)
    app.cwd = d
    app.doc_home = d
    app.images_mode = "sixel"
    app.gfx_decide(False, "", "", "")
    app.handle(key_event(fkey(1) | MOD_SHIFT))
    app.docs_show(site + "/pics.mdx", "", True)
    app.draw()
    var cap = -1
    for k in range(len(app.doc_lines)):
        if app.doc_lines[k].img == 0 and app.doc_lines[k].img_row == 0:
            cap = k - 1
    app.doc_scroll = cap - 3
    app.draw()
    # 100 x 80 pixels, cells of 10 x 20: 10 columns, 4 rows; the interlaced one stays a link
    assert_equal(len(app.doc_images), 1)
    assert_equal(app.doc_img_size[0], (10 << 16) | 4)
    app.sixel_prepare()
    var at = app.doc_img_shown[0]
    assert_true(at >= 0)
    var x = at & 0xFFFF
    var y = at >> 16
    assert_true(app.gfx_emit.startswith("\x1b[" + String(y + 1) + ";" + String(x + 1) + "H\x1bP0;1;0q\"1;1;100;80"), app.gfx_emit)
    assert_true(app.gfx_emit.find("#180;2;100;0;0") >= 0 and app.gfx_emit.find("#5;2;0;0;100") >= 0)
    var out = List[UInt8]()
    app.scr.render(out)
    var taken = app.sixel_take()
    assert_true(taken.startswith("\x1b[?25l\x1b[" + String(y + 1) + ";"))
    # the next frame, nothing changed: not drawn again
    app.draw()
    app.sixel_prepare()
    assert_equal(app.gfx_emit, "")
    app.scr.render(out)
    # scrolled so that it is only partly on the page: wiped (its cells sent again), not drawn
    app.doc_scroll = cap + 2
    app.draw()
    app.sixel_prepare()
    assert_equal(app.gfx_emit, "")
    assert_true(cells_dirty(app, x, y, 10, 4))
    assert_equal(app.doc_img_shown[0], -1)
    app.scr.render(out)
    # wholly on the page again, higher up: drawn there
    app.doc_scroll = cap
    app.draw()
    app.sixel_prepare()
    assert_true(app.gfx_emit.find("\x1bP0;1;0q") > 0)
    assert_true(app.doc_img_shown[0] >= 0 and app.doc_img_shown[0] != at)
    app.scr.render(out)
    # cut off at the bottom of the page (its first rows shown): not drawn either
    app.doc_scroll = cap + 1 - (app.docs_page_h() - 2)
    app.draw()
    app.sixel_prepare()
    assert_equal(app.gfx_emit, "")
    assert_equal(app.doc_img_shown[0], -1)
    _ = run_system("rm -rf " + shell_quote(d))


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
